# Primary API — SofaScore via RapidAPI
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=sportapi7.p.rapidapi.com

# Fallback API — AllScores (auto-switches when primary is rate-limited)
FALLBACK_RAPIDAPI_KEY=your_rapidapi_key_here
FALLBACK_RAPIDAPI_HOST=allscores.p.rapidapi.com

# Comma-separated sport slugs to track
SPORTS=football,basketball,tennis

# % change in decimal odds that triggers a value-bet alert
ODDS_MOVEMENT_PCT=5

# Poll interval in milliseconds
POLL_INTERVAL_MS=30000

# IANA timezone for AllScores API
TIMEZONE=America/Chicago
