# Primary API — SofaScore via RapidAPI
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=sportapi7.p.rapidapi.com

# Fallback API — AllScores (auto-switches when primary is rate-limited)
FALLBACK_RAPIDAPI_KEY=your_rapidapi_key_here
FALLBACK_RAPIDAPI_HOST=allscores.p.rapidapi.com

# Comma-separated sport slugs to track
SPORTS=football,basketball,tennis

# % change in decimal odds that triggers a value-bet alert
ODDS_MOVEMENT_PCT=5

# Poll interval in milliseconds
POLL_INTERVAL_MS=30000

# IANA timezone for AllScores API
TIMEZONE=America/Chicago

# Telegram — get token from @BotFather, chat ID from @userinfobot
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Minimum confidence % to surface a pick (bot self-adjusts over time)
MIN_CONFIDENCE=65

# Where to store pick history and self-learning data
BET_DATA_FILE=./betting-data.json

# ── Bankroll management (strategy rules) ────────────────────────────────────
# Total bankroll in USD
BANKROLL=1000
# Stake per bet as % of bankroll (2% recommended — never exceed 5%)
UNIT_PCT=2
# Max picks per day (discipline rule — 1-3 recommended)
MAX_PICKS_PER_DAY=3
# Min edge % (our confidence minus implied odds %) to approve a pick
MIN_EDGE_PCT=5
# Pause all picks after this many consecutive losses (anti-chase protection)
ANTI_CHASE_LOSSES=3

# Hour (0-23, local time) to send the daily Telegram morning briefing
DAILY_BRIEFING_HOUR=8
